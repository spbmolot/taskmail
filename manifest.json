{
  "manifest_version": 3,
  "name": "TaskMail — задачи из писем",
  "version": "2.0.0",
  "description": "Задачи с напоминаниями из писем Gmail и Яндекс Почты: срок, приоритет, комментарий и уведомление в нужный момент.",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://mail.yandex.ru/*",
    "https://mail.yandex.com/*",
    "https://mail.yandex.by/*",
    "https://mail.yandex.kz/*",
    "https://mail.360.yandex.ru/*",
    "https://mail.360.yandex.com/*",
    "https://360.yandex.ru/*",
    "https://e.mail.ru/*"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "commands": {
    "create-task": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Создать задачу из письма под курсором"
    }
  },
  "action": {
    "default_title": "TaskMail",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://mail.yandex.ru/*",
        "https://mail.yandex.com/*",
        "https://mail.yandex.by/*",
        "https://mail.yandex.kz/*",
        "https://mail.360.yandex.ru/*",
        "https://mail.360.yandex.com/*",
        "https://360.yandex.ru/*",
        "https://e.mail.ru/*"
      ],
      "js": ["src/content/extractor.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
